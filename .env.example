# Любой OpenAI-совместимый API. Скопируй в .env.local и заполни.
# Переменные читает только сервер (api/chat.ts и dev-middleware) — в браузер ключ не попадает.

# OpenAI (основной вариант). gpt-4.1 заметно лучше держит роль тимлида, чем gpt-4.1-mini:
# mini через раз «подтверждает» догадки («Да, ты правильно заметил…»). Модели gpt-5 / o-серии не подходят —
# не принимают temperature, и всё уйдёт в заготовки.
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1
API_KEY=

# OpenRouter: BASE_URL=https://openrouter.ai/api/v1   MODEL=openai/gpt-4.1

# Groq:   BASE_URL=https://api.groq.com/openai/v1           MODEL=llama-3.3-70b-versatile
# Gemini: BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   MODEL=gemini-2.5-flash
